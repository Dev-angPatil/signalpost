# Optional Serper web-search API key for website discovery. Leave blank to disable it.
SERPER_API_KEY=

# Optional Brave Search API. When set, Brave is preferred for missing-website discovery.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COST_PER_REQUEST_USD=0

# Optional official platform APIs. Leave blank to disable them.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_COST_PER_REQUEST_USD=0
YOUTUBE_DATA_API_KEY=

# ==============================================================================
# Signalpost Configuration Template
# ==============================================================================
# NOTE: Signalpost runs 100% out-of-the-box with ZERO API keys ($0.00 USD)
# using open Norwegian statutory registers (Brønnøysundregistrene & Kunngjøringer).
#
# ------------------------------------------------------------------------------
# 1. OPTIONAL WEB SEARCH DISCOVERY (PROVIDE ONLY ONE OF THESE 3 OPTIONS, OR NONE)
# ------------------------------------------------------------------------------
# You only need ONE search provider to unlock external website discovery.
# The agent auto-detects whichever key you provide below.

# Option A: Google Search via Serper API (~$0.001 / request)
SERPER_API_KEY=

# Option B: Brave Search API (~$0.005 / request)
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COST_PER_REQUEST_USD=0.005

# Option C: Google Custom Search JSON API (~$0.005 / request)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_COST_PER_REQUEST_USD=0.005

# Explicit provider override: 'auto', 'serper', 'brave', or 'google' (default: auto)
WEB_SEARCH_PROVIDER=auto

# ------------------------------------------------------------------------------
# 2. OPTIONAL PLATFORM FOOTPRINT APIS (ENRICHMENT ONLY)
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_COST_PER_REQUEST_USD=0.017
YOUTUBE_DATA_API_KEY=

# ==============================================================================
# Signalpost Configuration Template
# ==============================================================================
# NOTE: Signalpost runs 100% out-of-the-box with ZERO API keys ($0.00 USD)
# using open Norwegian statutory registers (Brønnøysundregistrene & Kunngjøringer).
#
# ------------------------------------------------------------------------------
# 1. OPTIONAL WEB SEARCH DISCOVERY (PROVIDE ONLY ONE OF THESE 3 OPTIONS, OR NONE)
# ------------------------------------------------------------------------------
# You only need ONE search provider to unlock external website discovery.
# The agent auto-detects whichever key you provide below.

# Option A: Google Search via Serper API (~$0.001 / request)
SERPER_API_KEY=

# Option B: Brave Search API (~$0.005 / request)
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COST_PER_REQUEST_USD=0.005

# Option C: Google Custom Search JSON API (~$0.005 / request)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_COST_PER_REQUEST_USD=0.005

# Explicit provider override: 'auto', 'serper', 'brave', or 'google' (default: auto)
WEB_SEARCH_PROVIDER=auto

# ------------------------------------------------------------------------------
# 2. OPTIONAL PLATFORM FOOTPRINT APIS (ENRICHMENT ONLY)
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
# Text Search with websiteUri + rating fields bills at the Enterprise SKU (~$0.035); verify current price.
GOOGLE_PLACES_COST_PER_REQUEST_USD=0.035
YOUTUBE_DATA_API_KEY=

# ------------------------------------------------------------------------------
# 3. NAV ARBEIDSPLASSEN JOB POSTINGS (FREE, NO KEY — public feed token fetched at run time)
# ------------------------------------------------------------------------------
# Days of the official NAV vacancy feed to index (0 disables the NAV connector).
NAV_FEED_DAYS=45
# Upper bound on feed walking time and on prefetched feed entries per batch.
NAV_FEED_MAX_SECONDS=720
NAV_PREFETCH_MAX_ENTRIES=4000
NAV_PREFETCH_WORKERS=4

# ------------------------------------------------------------------------------
# 4. OPTIONAL MODEL ANALYSIS (Claude) — summaries, job-ad and news analysis
# ------------------------------------------------------------------------------
# Skipped entirely when no key is set. Runs only for companies with a verified
# site, NAV job postings or dated news; spend is capped by MAX_THIRD_PARTY_COST_USD.
ANTHROPIC_API_KEY=
SIGNALPOST_AI_MODEL=claude-sonnet-5-5
SIGNALPOST_AI_WORKERS=6
# Set to 0 to disable model analysis even when a key is present.
SIGNALPOST_AI=1
SIGNALPOST_SEARCH_MODEL=claude-haiku-5-5

# ------------------------------------------------------------------------------
# 5. DISCOVERY BUDGET SLICES (USD per batch; all also capped by MAX_THIRD_PARTY_COST_USD)
# ------------------------------------------------------------------------------
MAX_THIRD_PARTY_COST_USD=9.50
SIGNALPOST_BUDGET_SEARCH=1.25
SIGNALPOST_BUDGET_RERANK=0.50
SIGNALPOST_BUDGET_PLACES=2.00
SIGNALPOST_BUDGET_AGENT_SEARCH=1.25
SIGNALPOST_BUDGET_CAREERS=0.50
SIGNALPOST_BUDGET_NEWS=0.75
SIGNALPOST_BUDGET_ANALYSIS=3.00
# Free Wikidata org-number -> website lookup (one request per 150 companies). 0 disables.
SIGNALPOST_WIKIDATA=1
# Optional headless rendering for JavaScript-only sites (needs `pip install playwright && playwright install chromium`).
SIGNALPOST_RENDER=0
